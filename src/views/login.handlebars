<div class="cabecalho-seccao">
    <h2><i class="fa-solid fa-lock"></i> Área Restrita</h2>
    <p>Acesso exclusivo para administradores do Pet Shop</p>
</div>

<div class="painel-formulario" style="max-width: 450px;">
    <!-- Alerta estilizado para senha errada -->
    {{#if erro}}
        <div class="alerta-selecao" style="background-color: #F8D7DA; color: #DC3545; border-color: #DC3545;">
            <i class="fa-solid fa-triangle-exclamation"></i> {{erro}}
        </div>
    {{/if}}

    <form action="/login" method="POST">
        <div class="grupo-input">
            <label><i class="fa-solid fa-user"></i> Usuário:</label>
            <input type="text" name="usuario" placeholder="Digite seu usuário" required>
        </div>

        <div class="grupo-input">
            <label><i class="fa-solid fa-key"></i> Senha:</label>
            <input type="password" name="senha" placeholder="Digite sua senha" required>
        </div>

        <button type="submit" class="btn btn-primario" style="width: 100%; margin-top: 15px;">
            <i class="fa-solid fa-right-to-bracket"></i> Entrar no Sistema
        </button>
    </form>
    
    <div style="margin-top: 25px; text-align: center; border-top: 1px solid #E9ECEF; padding-top: 15px;">
        <a href="/" style="color: var(--cor-secundaria); font-weight: bold; text-decoration: none;">
            <i class="fa-solid fa-arrow-left"></i> Voltar para clientes
        </a>
    </div>
</div>