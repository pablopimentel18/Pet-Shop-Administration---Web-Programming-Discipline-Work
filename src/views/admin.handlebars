<div class="cabecalho-seccao">
    <h2>{{titulo}}</h2>
</div>

<!-- Só aparece na rota /ajustaPetAgenda -->
{{#if mostrarFormulario}}
<div class="painel-formulario">
    <h3><i class="fa-solid fa-clock"></i> Adicionar / Atualizar Horário</h3>
    
    <form action="/ajustaPetAgenda" method="POST">
        <div class="grupo-input">
            <label>Dia da Semana:</label>
            <select name="dia" required>
                <option value="" disabled selected>Selecione...</option>
                <option value="Segunda">Segunda-feira</option>
                <option value="Terça">Terça-feira</option>
                <option value="Quarta">Quarta-feira</option>
                <option value="Quinta">Quinta-feira</option>
                <option value="Sexta">Sexta-feira</option>
                <option value="Sábado">Sábado</option>
            </select>
        </div>

        <div class="grupo-input">
            <label>Horário:</label>
            <select name="horario" required>
                <option value="" disabled selected>Escolha o horário...</option>
                <option value="08:00">08:00</option>
                <option value="08:30">08:30</option>
                <option value="09:00">09:00</option>
                <option value="09:30">09:30</option>
                <option value="10:00">10:00</option>
                <option value="10:30">10:30</option>
                <option value="11:00">11:00</option>
                <option value="11:30">11:30</option>
                <option value="12:00">12:00</option>
                <option value="12:00">12:30</option>
                <option value="12:00">13:00</option>
                <option value="13:30">13:30</option>
                <option value="14:00">14:00</option>
                <option value="14:30">14:30</option>
                <option value="15:00">15:00</option>
                <option value="15:30">15:30</option>
                <option value="16:00">16:00</option>
                <option value="16:30">16:30</option>
                <option value="17:00">17:00</option>
                <option value="17:30">17:30</option>
            </select>
        </div>

        <div class="grupo-input">
            <label>Capacidade (atendimentos simultâneos):</label>
            <input type="number" name="capacidade" min="0" required>
        </div>

        <button type="submit" class="btn btn-primario">Salvar Configuração</button>
    </form>
</div>
{{/if}}

<!-- Só aparece na rota /listaPetAgenda -->
{{#if mostrarLista}}
    
    <!-- TABELA 1: Clientes Agendados -->
    <h3 style="color: var(--cor-secundaria); margin-bottom: 15px;"><i class="fa-solid fa-clipboard-list"></i> Próximos Atendimentos</h3>
    <div class="tabela-container" style="margin-bottom: 50px;">
        <table class="tabela-admin">
            <thead>
                <tr>
                    <th>Data (Dia)</th>
                    <th>Horário</th>
                    <th>Cliente</th>
                    <th>CPF</th>
                </tr>
            </thead>
            <tbody>
                {{#each agendamentos}}
                    <tr>
                        <td><strong>{{this.dia}}</strong></td>
                        <td><span style="color: var(--cor-primaria); font-weight: bold;">{{this.horario}}</span></td>
                        <td>{{this.cliente_nome}}</td>
                        <td>{{this.cliente_cpf}}</td>
                    </tr>
                {{else}}
                    <tr>
                        <td colspan="4" style="text-align: center; padding: 25px; color: #6C757D;">Nenhum agendamento registrado até o momento.</td>
                    </tr>
                {{/each}}
            </tbody>
        </table>
    </div>

    <!-- TABELA 2: Grade de Horários do Pet Shop (Configuração Geral) -->
    <h3 style="color: var(--cor-secundaria); margin-bottom: 15px;"><i class="fa-solid fa-calendar-days"></i> Grade do Pet Shop (Disponibilidade)</h3>
    <div class="tabela-container">
        <table class="tabela-admin">
            <thead>
                <tr>
                    <th>Dia</th>
                    <th>Horário</th>
                    <th>Capacidade Total</th>
                    <th>Vagas Disponíveis Agora</th>
                </tr>
            </thead>
            <tbody>
                {{#each horariosCadastrados}}
                    <tr>
                        <td><strong>{{this.dia}}</strong></td>
                        <td>{{this.horario}}</td>
                        <td>{{this.capacidadeTotal}} atendimento(s)</td>
                        <td>
                            <!-- Destaque visual se as vagas acabarem -->
                            <span style="padding: 4px 10px; border-radius: 20px; background-color: {{#if this.capacidadeDisponivel}}#E6FAFD{{else}}#F8D7DA{{/if}}; color: {{#if this.capacidadeDisponivel}}var(--cor-primaria){{else}}#DC3545{{/if}}; font-weight: bold;">
                                {{this.capacidadeDisponivel}} vaga(s)
                            </span>
                        </td>
                    </tr>
                {{else}}
                    <tr>
                        <td colspan="4" style="text-align: center; padding: 25px; color: #6C757D;">Nenhum horário configurado. Vá em 'Configurações' para abrir a agenda.</td>
                    </tr>
                {{/each}}
            </tbody>
        </table>
    </div>

{{/if}}