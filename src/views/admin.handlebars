<div class="cabecalho-seccao">
    <h2>{{titulo}}</h2>
</div>

<!-- Só aparece na rota /ajustaPetAgenda -->
{{#if mostrarFormulario}}
<div class="painel-formulario" style="max-width: 100%;">
    <h3><i class="fa-solid fa-clock"></i> Adicionar / Atualizar Horário Único</h3>
    
    <form action="/ajustaPetAgenda" method="POST" style="display: flex; gap: 15px; align-items: flex-end; flex-wrap: wrap;">
        <div class="grupo-input" style="flex: 1; margin-bottom: 0;">
            <label>Dia da Semana:</label>
            <select name="dia" required>
                <option value="" disabled selected>Selecione...</option>
                <option value="Segunda">Segunda-feira</option>
                <option value="Terça">Terça-feira</option>
                <option value="Quarta">Quarta-feira</option>
                <option value="Quinta">Quinta-feira</option>
                <option value="Sexta">Sexta-feira</option>
                <option value="Sábado">Sábado</option>
            </select>
        </div>

        <div class="grupo-input" style="flex: 1; margin-bottom: 0;">
            <label>Horário:</label>
            <select name="horario" required>
                <option value="" disabled selected>Escolha...</option>
                <option value="08:00">08:00</option>
                <option value="08:30">08:30</option>
                <option value="09:00">09:00</option>
                <option value="09:30">09:30</option>
                <option value="10:00">10:00</option>
                <option value="10:30">10:30</option>
                <option value="11:00">11:00</option>
                <option value="11:30">11:30</option>
                <option value="12:00">12:00</option>
                <option value="12:30">12:30</option>
                <option value="13:00">13:00</option>
                <option value="13:30">13:30</option>
                <option value="14:00">14:00</option>
                <option value="14:30">14:30</option>
                <option value="15:00">15:00</option>
                <option value="15:30">15:30</option>
                <option value="16:00">16:00</option>
                <option value="16:30">16:30</option>
                <option value="17:00">17:00</option>
                <option value="17:30">17:30</option>
            </select>
        </div>

        <div class="grupo-input" style="flex: 1; margin-bottom: 0;">
            <label>Capacidade (vagas):</label>
            <input type="number" name="capacidade" min="0" required>
        </div>

        <button type="submit" class="btn btn-primario" style="flex: 1; height: 50px;">Salvar</button>
    </form>

    <hr style="margin: 40px 0; border: 1px solid var(--cor-borda);">

    <h3><i class="fa-solid fa-table-cells"></i> Grade Semanal de Capacidade (Edição Rápida)</h3>
    <form action="/salvarGradeMassa" method="POST">
        <div class="tabela-container">
            <table class="tabela-admin" style="text-align: center;">
                <thead>
                    <tr>
                        <th style="text-align: center;">Horário</th>
                        {{#each diasDaSemana}}
                            <th style="text-align: center;">{{this}}</th>
                        {{/each}}
                    </tr>
                </thead>
                <tbody>
                    {{#each grade}}
                        <tr>
                            <td><strong>{{this.horario}}</strong></td>
                            {{#each this.capacidades}}
                                <td>
                                    <input type="number"
                                           name="grade[{{../horario}}][{{this.dia}}]"
                                           value="{{this.valor}}"
                                           min="0"
                                           style="width: 60px; text-align: center; padding: 5px; border: 1px solid #ccc; border-radius: 4px;">
                                </td>
                            {{/each}}
                        </tr>
                    {{else}}
                        <tr>
                            <td colspan="7" style="padding: 20px; color: #6C757D;">Nenhum horário configurado ainda. Use o formulário acima para criar a primeira linha.</td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        
        <button type="submit" style="margin-top: 15px; padding: 12px; background: #28a745; border: none; border-radius: 8px; color: white; width: 100%; font-weight: bold; font-size: 1.1rem; cursor: pointer; transition: 0.3s;">
            <i class="fa-solid fa-floppy-disk"></i> Salvar Alterações da Grade
        </button>
    </form>
</div>
{{/if}}

<!-- Só aparece na rota /listaPetAgenda -->
{{#if mostrarLista}}
    
    <!-- TABELA 1: Clientes Agendados -->
    <h3 style="color: var(--cor-secundaria); margin-bottom: 15px;"><i class="fa-solid fa-clipboard-list"></i> Próximos Atendimentos</h3>
    <div class="tabela-container" style="margin-bottom: 50px;">
        <table class="tabela-admin">
            <thead>
                <tr>
                    <th>Data</th>
                    <th>Horário</th>
                    <th>Cliente</th>
                    <th>CPF</th>
                </tr>
            </thead>
            <tbody>
                {{#each agendamentos}}
                    <tr>
                        <td><strong>{{this.data_exata}} ({{this.dia}})</strong></td>
                        <td>{{this.horario}}</td>
                        <td>{{this.cliente_nome}}</td>
                        <td>{{this.cliente_cpf}}</td>
                    </tr>
                {{else}}
                    <tr>
                        <td colspan="4" style="text-align: center; padding: 25px; color: #6C757D;">Nenhum agendamento registrado até o momento.</td>
                    </tr>
                {{/each}}
            </tbody>
        </table>
    </div>

    <!-- TABELA 2: Grade de Horários do Pet Shop AGRUPADA -->
    
    {{#if gradeAgrupada.length}}
        <div style="display: flex; flex-direction: column; gap: 30px;">
                                    
                    <h3 style="color: var(--cor-secundaria); margin-bottom: 15px;"><i class="fa-solid fa-calendar-days"></i> Disponibilidade dos Próximos 7 Dias</h3>
                    
                    <div class="tabela-container">
                        {{#each gradeAgrupada}}
                            <!-- Cabeçalho do dia específico -->
                            <h4 style="margin-top: 20px; background-color: #E9ECEF; padding: 10px; border-radius: 5px; color: #333;">
                                {{this.dia}} - {{this.dataExata}}
                            </h4>
                            
                            <table class="tabela-admin" style="width: 100%; text-align: left; border-collapse: collapse; margin-bottom: 20px;">
                                <thead>
                                    <tr>
                                        <th style="padding: 10px; border-bottom: 2px solid #ddd;">Horário</th>
                                        <th style="padding: 10px; border-bottom: 2px solid #ddd;">Capacidade Total</th>
                                        <th style="padding: 10px; border-bottom: 2px solid #ddd;">Status das Vagas</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#each this.horarios}}
                                        <tr>
                                            <td style="padding: 10px; border-bottom: 1px solid #eee;"><strong>{{this.horario}}</strong></td>
                                            <td style="padding: 10px; border-bottom: 1px solid #eee;">{{this.capacidadeTotal}} atendimento(s)</td>
                                            <td style="padding: 10px; border-bottom: 1px solid #eee;">
                                                <!-- A lógica de cor agora funciona perfeitamente com os dados calculados do Node -->
                                                <span style="padding: 4px 10px; border-radius: 20px; background-color: {{#if this.capacidadeDisponivel}}#E6FAFD{{else}}#F8D7DA{{/if}}; color: {{#if this.capacidadeDisponivel}}var(--cor-primaria){{else}}#DC3545{{/if}}; font-weight: bold;">
                                                    {{this.capacidadeDisponivel}} vaga(s) disponível(is)
                                                </span>
                                            </td>
                                        </tr>
                                    {{/each}}
                                </tbody>
                            </table>
                        {{else}}
                            <p style="text-align: center; padding: 20px; color: #6C757D;">Nenhuma projeção disponível. Configure a grade de horários primeiro.</p>
                        {{/each}}
                    </div>

        </div>
    {{else}}
        <div class="tabela-container">
            <table class="tabela-admin">
                <tr>
                    <td style="text-align: center; padding: 25px; color: #6C757D;">Nenhum horário configurado. Vá em 'Gerenciar Horários' para abrir a agenda.</td>
                </tr>
            </table>
        </div>
    {{/if}}

{{/if}}