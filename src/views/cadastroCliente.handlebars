<div class="cabecalho-seccao">
    <h2>Cadastro de Novo Cliente</h2>
    <p>Cadastre-se para agendar os melhores cuidados para o seu pet.</p>
</div>

<div class="painel-formulario">
    <form action="/cadastroCliente" method="POST">
        <div class="grupo-input">
            <label>Nome Completo:</label>
            <input type="text" name="nome" placeholder="Ex: Maria da Silva" required>
        </div>

        <div class="grupo-input">
            <label>CPF:</label>
            <input type="text" name="cpf" placeholder="000.000.000-00" required maxlength="14" oninput="mascaraCPF(this)">
        </div>

        <div class="grupo-input">
            <label>E-mail:</label>
            <input type="email" name="email" placeholder="exemplo@email.com" required>
        </div>

        <button type="submit" class="btn btn-primario">
            <i class="fa-solid fa-check"></i> Finalizar Cadastro
        </button>
    </form>
    
    <div style="margin-top: 25px; text-align: center; border-top: 1px solid #E9ECEF; padding-top: 15px;">
        <a href="/" style="color: var(--cor-secundaria); font-weight: bold; text-decoration: none;">
            <i class="fa-solid fa-arrow-left"></i> Já sou cadastrado (Voltar ao Agendamento)
        </a>
    </div>
</div>

<script>
    function mascaraCPF(campo) {
        let valor = campo.value.replace(/\D/g, "");
        valor = valor.replace(/(\d{3})(\d)/, "$1.$2");
        valor = valor.replace(/(\d{3})(\d)/, "$1.$2");
        valor = valor.replace(/(\d{3})(\d{1,2})$/, "$1-$2");
        campo.value = valor;
    }
</script>