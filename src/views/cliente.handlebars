<h1>Agendamento - Banho e Tosa</h1>
<hr>

{{#if horarios.length}}
    <section style="max-width: 400px; margin-top: 20px;">
        <h3>Agende o seu horário</h3>
        <form action="/agendar" method="POST">
            
            <label style="display: block; margin-top: 10px;">Selecione um horário disponível:</label>
            <select name="horario_id" required style="width: 100%;">
                <option value="" disabled selected>Escolha um dia e horário...</option>
                {{#each horarios}}
                    <option value="{{this._id}}">
                        {{this.dia}} às {{this.horario}} (Vagas: {{this.capacidadeDisponivel}})
                    </option>
                {{/each}}
            </select>

            <label style="display: block; margin-top: 10px;">Informe o seu CPF:</label>
            <input type="text" name="cpf" placeholder="Apenas números" required style="width: 100%;">

            <button type="submit" style="display: block; margin-top: 15px; padding: 10px; background: green; color: white; width: 100%;">
                Confirmar Agendamento
            </button>
        </form>

        <div style="margin-top: 20px; padding: 15px; background: #f9f9f9; text-align: center; border: 1px solid #ddd;">
            <p style="margin: 0 0 10px 0;"><strong>Ainda não é nosso cliente?</strong></p>
            <a href="/cadastroCliente" style="padding: 8px 15px; background: blue; color: white; text-decoration: none;">
                Fazer Cadastro
            </a>
        </div>
    </section>
{{else}}
    <section style="padding: 20px; background-color: #f8d7da; color: #721c24;">
        <p>Infelizmente não temos horários disponíveis no momento. Tente novamente mais tarde.</p>
    </section>
{{/if}}