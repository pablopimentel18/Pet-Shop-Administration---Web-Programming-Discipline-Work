<div class="cabecalho-seccao">
    <h2>Agendamento - Banho e Tosa</h2>
    <p>Selecione o melhor horário para o seu pet e garanta um atendimento exclusivo.</p>
</div>

{{#if horariosAgrupados.length}}
    <!-- Dias da Semana e Horários -->
    <div style="margin-bottom: 20px;">
        {{#each horariosAgrupados}}
            <!-- Bloco de um dia específico (ex: Segunda) -->
            <div style="margin-bottom: 25px; padding: 15px; border: 1px solid #E9ECEF; border-radius: 8px; background-color: #FAFAFA; box-shadow: var(--sombra-suave);">
                
                <!-- Título do dia -->
                <h4 style="margin-top: 0; margin-bottom: 15px; color: var(--cor-secundaria); border-bottom: 2px solid var(--cor-primaria); padding-bottom: 8px;">
                    <i class="fa-regular fa-calendar"></i> {{this.dia}} ({{this.dataExata}})
                </h4>
                
                <!-- Flexbox: Organiza os horários um ao lado do outro na mesma linha -->
                <div style="display: flex; gap: 15px; flex-wrap: wrap;">
                    {{#each this.slots}}
                        <div class="cartao-horario" style="flex: 1 1 200px; max-width: 250px;">
                            <div>
                                <p class="hora">{{this.horario}}</p>
                                <p class="vagas" style="margin-bottom: 10px;"><i class="fa-solid fa-users"></i> {{this.capacidadeDisponivel}} vagas</p>
                            </div>
                            <button type="button" class="btn btn-selecionar" onclick="selecionarHorario('{{this._id}}', '{{../dia}}', '{{this.horario}}', '{{this.dataExata}}')">
                                Selecionar
                            </button>
                        </div>
                    {{/each}}
                </div>
            </div>
        {{/each}}
    </div>

    <!-- Formulário Final -->
    <div class="painel-formulario" id="zona-formulario">
        <h3><i class="fa-solid fa-calendar-check"></i> Confirme seu Horário</h3>
        <div id="alerta-selecao" class="alerta-selecao" style="display: none; margin-bottom: 15px; padding: 10px; background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; border-radius: 5px;">
            Horário escolhido: <strong id="texto-horario-selecionado">Nenhum</strong>
        </div>

        <form action="/agendar" method="POST" id="formAgendamento">
            <!-- O ID oculto que vai para o rotas.js do Pablo -->
            <input type="hidden" id="horario_id" name="horario_id" required>
            <input type="hidden" id="data_exata" name="data_exata" required>

            <div class="grupo-input">
                <label for="cpf">Informe o seu CPF (já cadastrado):</label>
                <!-- Máscara aplicada diretamente no input -->
                <input type="text" id="cpf" name="cpf" placeholder="000.000.000-00" required maxlength="14" oninput="mascaraCPF(this)">
            </div>

            <button type="submit" class="btn btn-primario" id="btn-submit" disabled>
                Confirmar Agendamento
            </button>
        </form>

        <div style="margin-top: 25px; text-align: center; padding-top: 15px; border-top: 1px solid #E9ECEF;">
            <p style="color: #6C757D; margin-bottom: 10px;">Ainda não é nosso cliente?</p>
            <a href="/cadastroCliente" style="color: var(--cor-primaria); font-weight: bold; text-decoration: none;">
                <i class="fa-solid fa-user-plus"></i> Fazer Cadastro
            </a>
        </div>
    </div>

    <script>
        function selecionarHorario(id, dia, hora, dataExata) {
            // Alimenta o backend do Pablo
            document.getElementById('horario_id').value = id;
            document.getElementById('data_exata').value = dataExata;
            // UI/UX para o cliente
            const alerta = document.getElementById('alerta-selecao');
            alerta.style.display = 'block';
            document.getElementById('texto-horario-selecionado').innerText = dia + ' às ' + hora + ' (' + dataExata + ')';
            
            document.getElementById('btn-submit').disabled = false;
            document.getElementById('zona-formulario').scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        function mascaraCPF(campo) {
            let valor = campo.value.replace(/\D/g, "");
            valor = valor.replace(/(\d{3})(\d)/, "$1.$2");
            valor = valor.replace(/(\d{3})(\d)/, "$1.$2");
            valor = valor.replace(/(\d{3})(\d{1,2})$/, "$1-$2");
            campo.value = valor;
        }
    </script>
{{else}}
    <div style="text-align: center; padding: 60px 20px; background: white; border-radius: 12px; box-shadow: var(--sombra-suave);">
        <i class="fa-regular fa-face-frown" style="font-size: 4rem; color: #ccc; margin-bottom: 20px;"></i>
        <h3 style="color: var(--cor-secundaria);">Poxa! Não temos horários disponíveis no momento.</h3>
        <p style="color: #6C757D; margin-top: 10px;">Por favor, retorne mais tarde ou entre em contato pelo nosso telefone.</p>
    </div>
{{/if}}