<div class="cabecalho-seccao">
    <h2>Agende o Banho e Tosa do seu Pet</h2>
    <p>Selecione o horário ideal para você e garanta o melhor cuidado para o seu companheiro.</p>
</div>

<!-- Grade de Horários -->
<div class="grid-horarios">
    {{#each horarios}}
        <div class="cartao-horario">
            <div>
                <p class="dia">{{this.diaSemana}}</p>
                <p class="hora">{{this.horario}}</p>
                <p class="vagas"><i class="fa-solid fa-users"></i> {{this.capacidadeDisponivel}} vagas disponíveis</p>
            </div>
            <button type="button" class="btn btn-selecionar" onclick="selecionarHorario('{{this.diaSemana}}', '{{this.horario}}')">
                Selecionar
            </button>
        </div>
    {{else}}
        <div style="grid-column: 1 / -1; text-align: center; padding: 40px; background: white; border-radius: 8px;">
            <i class="fa-regular fa-face-frown" style="font-size: 3rem; color: #ccc; margin-bottom: 15px;"></i>
            <h3>Poxa! Não há vagas no momento.</h3>
            <p>Por favor, retorne mais tarde ou entre em contato por telefone.</p>
        </div>
    {{/each}}
</div>

<!-- Formulário de Confirmação -->
<div class="painel-formulario" id="zona-formulario">
    <h3><i class="fa-solid fa-check-circle"></i> Confirme o Agendamento</h3>
    
    <div id="alerta-selecao" class="alerta-selecao" style="display: none;">
        Selecionado: <strong id="texto-horario-selecionado">Nenhum</strong>
    </div>

    <form action="/agendar" method="POST" id="formAgendamento">
        <input type="hidden" id="inputDia" name="diaSemana" required>
        <input type="hidden" id="inputHora" name="horario" required>

        <div class="grupo-input">
            <label for="nome">Nome Completo</label>
            <input type="text" id="nome" name="nome" placeholder="Ex: João da Silva" required>
        </div>

        <div class="grupo-input">
            <label for="cpf">CPF</label>
            <input type="text" id="cpf" name="cpf" placeholder="000.000.000-00" required maxlength="14" oninput="mascaraCPF(this)">
        </div>

        <div class="grupo-input">
            <label for="telefone">Telefone / WhatsApp</label>
            <input type="tel" id="telefone" name="telefone" placeholder="(00) 00000-0000" required maxlength="15" oninput="mascaraTelefone(this)">
        </div>

        <button type="submit" class="btn btn-primario" id="btn-submit" disabled>
            Concluir Agendamento
        </button>
    </form>
</div>

<script>
    function selecionarHorario(dia, hora) {
        document.getElementById('inputDia').value = dia;
        document.getElementById('inputHora').value = hora;
        
        const alerta = document.getElementById('alerta-selecao');
        alerta.style.display = 'block';
        document.getElementById('texto-horario-selecionado').innerText = dia + ' às ' + hora;
        
        const btnSubmit = document.getElementById('btn-submit');
        btnSubmit.disabled = false;
        
        document.getElementById('zona-formulario').scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
    // Função para selecionar o horário e habilitar o botão
    function selecionarHorario(dia, hora) {
        document.getElementById('inputDia').value = dia;
        document.getElementById('inputHora').value = hora;
        
        const alerta = document.getElementById('alerta-selecao');
        alerta.style.display = 'block';
        document.getElementById('texto-horario-selecionado').innerText = dia + ' às ' + hora;
        
        const btnSubmit = document.getElementById('btn-submit');
        btnSubmit.disabled = false;
        
        document.getElementById('zona-formulario').scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    // Função para formatar o CPF (000.000.000-00)
    function mascaraCPF(campo) {
        let valor = campo.value.replace(/\D/g, ""); // Remove tudo o que não é número
        
        // Aplica a formatação em etapas
        valor = valor.replace(/(\d{3})(\d)/, "$1.$2");
        valor = valor.replace(/(\d{3})(\d)/, "$1.$2");
        valor = valor.replace(/(\d{3})(\d{1,2})$/, "$1-$2");
        
        campo.value = valor;
    }

    // Função para formatar o Telefone ((00) 00000-0000 ou (00) 0000-0000)
    function mascaraTelefone(campo) {
        let valor = campo.value.replace(/\D/g, ""); // Remove tudo o que não é número
        
        // Aplica a formatação
        valor = valor.replace(/^(\d{2})(\d)/g, "($1) $2");
        valor = valor.replace(/(\d)(\d{4})$/, "$1-$2");
        
        campo.value = valor;
    }
</script>